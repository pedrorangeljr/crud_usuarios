<div class="d-flex justify-content-between mb-3">
  <h2>Usuários</h2>
  <%= link_to "Novo Usuário", new_user_path, class:"btn btn-success"%>
</div>
<div class="row mb-4">
  <div class="col-md-8">
    <%= form_with url: users_path,
                  method: :get,
                  local: true do %>
      <div class="input-group">
        <%= text_field_tag :q,
                           params[:q],
                           class: "form-control",
                           placeholder: "Pesquisar por nome ou e-mail..." %>
        <button class="btn btn-primary">
          Pesquisar
        </button>
        <% if params[:q].present? %>
          <%= link_to "Limpar",
                      users_path,
                      class: "btn btn-secondary" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
<table class="table table-striped table-bordered">
  <thead>
    <tr>
      <th>ID</th>
      <th>Nome</th>
      <th>Email</th>
      <th>Idade</th>
      <th>Ações</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.id %></td>
        <td><%= user.nome %></td>
        <td><%= user.email %></td>
        <td><%= user.idade %></td>
        <td>
          <%= link_to "Visualizar", user, class: "btn btn-info btn-sm"%>
          <%= link_to "Editar", edit_user_path(user), class: "btn btn-warning btn-sm"%>
          <%= link_to "Excluir", user, data: {
                turbo_method: :delete,
                turbo_confirm: "Deseja excluir?"
            }, class: "btn btn-danger btn-sm" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>