<div class="card">
  <div class="card-header">
    <h3><%= @user.nome %></h3>
  </div>
  <div class="card-body">
    <p>
      <strong>Email:</strong>
      <%= @user.email %>
    </p>
    <p>
      <strong>Idade:</strong>
      <%= @user.idade %>
    </p>
  </div>
</div>
<br>
<%= link_to "Editar",
edit_user_path(@user),
class:"btn btn-warning" %>
<%= link_to "Voltar",
users_path,
class:"btn btn-secondary" %>